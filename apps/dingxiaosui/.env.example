# Production configuration example only. No real values are included.
APP_ENV=production
PASSWORD_AUTH_ENABLED=1
APP_ORIGIN=https://your-domain.example
ZDX_DATA_DIR=/absolute/path/to/private-data
AI_CONFIG_ENCRYPTION_KEY=

# Server-side integration only. Inject into the process environment when using
# scripts/start-event-preview.mjs (it does not load this file automatically).
QUOTA_CENTER_URL=https://your-quota-center.example
QUOTA_PLATFORM_KEY=
SHOP_PRODUCT_URL=https://your-shop.example/?service=dingxiaosui-creator
